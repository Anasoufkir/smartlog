# Copiez ce fichier vers .env et renseignez vos propres valeurs.
# .env n'est jamais commité (voir .gitignore).

# Clé API Anthropic — requise pour le rapport IA (POST /ai/analyze).
# Sans cette clé, le reste de l'application fonctionne normalement ;
# seul le rapport IA renverra une erreur 503.
ANTHROPIC_API_KEY=sk-ant-...

# Identifiants du compte admin créé au tout premier démarrage
# (uniquement si data/users.json n'existe pas encore).
# Changez-les via le panel admin si vous avez démarré sans les définir.
LOGSCOPE_ADMIN_USER=admin
LOGSCOPE_ADMIN_PASS=changez-moi
